# BISSECCAO passo 1: para logo depois do `bun install`.
# A API do EasyPanel nao devolve saida de build, so sucesso ou falha — entao o
# sinal e o proprio resultado do deploy. Se este passar, o problema esta no
# turbo build; se falhar, esta na instalacao.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl curl unzip \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g bun@1.3.12

WORKDIR /repo
COPY . .

RUN bun install --frozen-lockfile

CMD ["sleep", "infinity"]
