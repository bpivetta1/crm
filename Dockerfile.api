# apps/api — NestJS sobre Bun. E quem serve /api/auth/* e detem o banco,
# por isso as migracoes rodam aqui no start, e nao nos outros dois servicos.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl curl unzip \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g bun@1.3.12

WORKDIR /repo
COPY . .

# packages/db/prisma.config.ts resolve env("DATABASE_URL") assim que e
# carregado, e o postinstall de @crm/db roda `prisma generate` — sem a variavel
# o `bun install` morre com PrismaConfigEnvError. O valor aqui e de fachada e
# fica so na linha do RUN: generate nao conecta no banco, e assim a credencial
# real nunca entra numa camada da imagem. No runtime vale a env do servico.
ARG DB_FACHADA=postgresql://build:build@127.0.0.1:5432/build?schema=public

RUN DATABASE_URL=$DB_FACHADA bun install --frozen-lockfile
# apps/api/src/generated/server.ts vem versionado e o build NAO pode regerar:
# o gerador exige uma GLIBC mais nova que a da imagem. Regerar e local.
RUN DATABASE_URL=$DB_FACHADA bunx turbo run build --filter=api

ENV NODE_ENV=production \
    PORT=3001
EXPOSE 3001
CMD ["sh", "-c", "cd packages/db && bunx prisma migrate deploy && cd ../../apps/api && exec bun run start:prod"]
