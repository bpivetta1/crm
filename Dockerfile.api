# TEMPORARIO — captura do erro do `bun install`.
# A API do EasyPanel nao devolve saida de build e nao ha endpoint de log, entao
# cada passo roda com `|| true`, grava em /srv e o container serve o texto na
# porta 3001 (a mesma que o dominio api-crm.nefo.pro ja aponta).
# Substituir pelo Dockerfile real assim que a causa estiver identificada.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl curl unzip \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g bun@1.3.12

WORKDIR /repo
COPY . .

RUN mkdir -p /srv
RUN (echo "### versoes"; node -v; bun -v; echo; echo "### memoria"; free -m 2>/dev/null || true; echo; echo "### disco"; df -h / 2>/dev/null) > /srv/05-ambiente.log 2>&1 || true
RUN (bun install --frozen-lockfile; echo "EXIT=$?") > /srv/10-install-frozen.log 2>&1 || true
RUN (bun install; echo "EXIT=$?") > /srv/20-install-livre.log 2>&1 || true
RUN cd /srv && (for f in $(ls *.log); do echo "===== $f"; tail -c 30000 "$f"; echo; done) > /tmp/all.txt && mv /tmp/all.txt /srv/all.txt

EXPOSE 3001
CMD ["node","-e","const fs=require('fs');require('http').createServer((q,s)=>{s.writeHead(200,{'content-type':'text/plain; charset=utf-8'});s.end(fs.readFileSync('/srv/all.txt','utf8'))}).listen(3001)"]
