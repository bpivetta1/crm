# apps/agent — runtime eve. Na Vercel ele usaria o Vercel Sandbox; fora dela,
# eve/sandbox escolhe sozinho: usa `vercel` se a env VERCEL existir, senao
# `docker` se o daemon responder, senao microsandbox, senao justbash — que roda
# sem isolamento nenhum. Por isso a CLI do docker entra na imagem; o socket
# precisa estar montado no servico para o backend bom ser escolhido.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl curl unzip \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g bun@1.3.12

# So o binario do cliente docker: ele fala com o socket do host, nao sobe daemon.
RUN curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.5.1.tgz \
      -o /tmp/docker.tgz \
 && tar -xzf /tmp/docker.tgz -C /usr/local/bin --strip-components=1 docker/docker \
 && rm /tmp/docker.tgz \
 && docker --version

WORKDIR /repo
COPY . .

# Ver Dockerfile.api: prisma.config.ts exige DATABASE_URL ja no postinstall.
ARG DB_FACHADA=postgresql://build:build@127.0.0.1:5432/build?schema=public

RUN DATABASE_URL=$DB_FACHADA bun install --frozen-lockfile
RUN DATABASE_URL=$DB_FACHADA bunx turbo run build --filter=agent

ENV NODE_ENV=production \
    AGENT_PORT=2000
EXPOSE 2000
WORKDIR /repo/apps/agent
CMD ["bun", "run", "start"]
