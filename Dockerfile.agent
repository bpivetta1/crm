# apps/agent — runtime eve. Na Vercel ele usaria o Vercel Sandbox; fora dela,
# eve/sandbox escolhe sozinho: se a env VERCEL nao existe e o daemon do Docker
# responde, ele usa o backend docker. Por isso a CLI do docker entra na imagem
# e /var/run/docker.sock precisa estar montado no servico.
# Sem daemon ele nao quebra: cai para microsandbox e, por fim, justbash — que
# roda sem isolamento nenhum.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl curl unzip \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g bun@1.3.12

# Só o binario do cliente docker: ele fala com o socket do host, nao sobe daemon.
RUN curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.5.1.tgz \
      -o /tmp/docker.tgz \
 && tar -xzf /tmp/docker.tgz -C /usr/local/bin --strip-components=1 docker/docker \
 && rm /tmp/docker.tgz \
 && docker --version

WORKDIR /repo
COPY . .

RUN bun install --frozen-lockfile
RUN bunx turbo run build --filter=agent

ENV NODE_ENV=production \
    AGENT_PORT=2000
EXPOSE 2000
WORKDIR /repo/apps/agent
CMD ["bun", "run", "start"]
